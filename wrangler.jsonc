{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chika-kohji",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chika-kohji.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["43 21 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chika-kohji",
      "database_id": "a8ce7f9d-d080-4aab-93c1-a15c983f38a9",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
